# Copy this file to .env for local `npm run dev:control-plane` use, or set
# these as real environment variables however your platform prefers. Every
# variable here is optional — Wharf runs with sane defaults if you set none
# of them, in the single-user local/dev bootstrap window described in the
# README. `deploy/docker-compose.yml` sets the same variables for the
# self-host quickstart, with the same defaults.

# --- Auth -------------------------------------------------------------
# Admin/service token. Until this is set (or the first account signs up),
# the control plane runs in single-user local/dev mode with no login
# required. Set this before pointing the URL at anyone but yourself.
WHARF_TOKEN=

# Set to "true" once Wharf is served over HTTPS (e.g. behind a tunnel or a
# real domain) so session cookies get the Secure flag. Leave unset/false
# for plain-HTTP local development.
WHARF_COOKIE_SECURE=false

# --- Networking ---------------------------------------------------------
# Where the control plane's OWN queries reach sibling database containers
# it provisions (not "localhost" — that's the control plane's own container).
# On a plain host running the daemon directly, "localhost" is usually right.
WHARF_PROBE_HOST=localhost

# Where connection strings shown to users point — typically the machine or
# domain Wharf is reachable at. Also settable from the first-boot setup
# wizard or Settings (as an IP or a domain) once you're running — this env
# var is an ABSOLUTE override on top of that when set, so an existing
# docker-compose deployment that already sets it keeps working unchanged.
WHARF_PUBLIC_HOST=localhost

# --- Storage --------------------------------------------------------------
# Directory for the SQLite metadata store and local backup files.
WHARF_DATA_DIR=./data

# --- Capacity & resource limits (all optional, unset/0 = no cap) ----------
# Caps how many instances this control plane will ever create in total —
# protects a shared host from one person exhausting it.
WHARF_MAX_INSTANCES=0

# Caps the combined cpu (cores) / memory (MB) reserved across every
# instance on the host, enforced on create AND on live resize.
WHARF_MAX_TOTAL_CPU=0
WHARF_MAX_TOTAL_MEMORY_MB=0

# --- Ask your data (optional) ---------------------------------------------
# Enables the natural-language "ask your data" query box via OpenRouter
# (https://openrouter.ai). Each signed-in user picks their own model from
# OpenRouter's live catalog. Leave unset to keep the feature off — the UI
# shows a hint instead of the input box.
OPENROUTER_API_KEY=

# --- Alerting (optional) ---------------------------------------------------
# A URL to POST a JSON payload to when an instance's cpu/memory usage
# crosses a threshold, or a query runs slower than the threshold below.
# Off entirely unless set.
WHARF_ALERT_WEBHOOK_URL=
WHARF_ALERT_CPU_THRESHOLD_PERCENT=90
WHARF_ALERT_MEMORY_THRESHOLD_PERCENT=90
WHARF_ALERT_SLOW_QUERY_MS=5000
WHARF_ALERT_COOLDOWN_MINUTES=30

# --- Misc -------------------------------------------------------------------
# Sample data seeded into every freshly created instance, so the data
# browser isn't empty on first look. Set to "false" to disable.
WHARF_SEED_SAMPLE_DATA=true

# How often (ms) the background scheduler checks for due backups/alerts.
WHARF_SCHEDULER_INTERVAL_MS=60000
